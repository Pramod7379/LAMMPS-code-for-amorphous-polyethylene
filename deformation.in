# Intialization
units          real
dimension      3
boundary       p p p
atom_style     full

bond_style   harmonic
angle_style   harmonic
dihedral_style  opls
special_bonds  lj 0.0 0.0 0.0 dihedral no

# read data file
read_data   system_after_npt_100K

pair_style   lj/cut/coul/cut  6.0 12.0

pair_coeff  1   1  0.2104 3.7654 
pair_coeff  1   2  0.0862 4.0685  
pair_coeff  2   2  0.0862 4.0685 


pair_modify tail yes
neighbor       1 bin
#neigh_modify    every 100 delay 0 check yes
timestep 1

thermo 100

# Uniaxial compression at strain rate -1e09 s-1 #
 
fix 1   all npt temp 300.0 300.0 500.0 y 0 0 100 z 0 0 100 

variable tmp equal "lx"
variable L0 equal ${tmp}
variable srate equal 1.0e9
variable srate1 equal "-v_srate / 1.0e15"
fix 2 all deform 1 x erate ${srate1} units box remap x

# for uits real, pressure is in [atms]= 1*0.101325 [MPa]
#  p2,p3,p4  are in MPa

variable strain equal "lx/v_L0"

variable p2 equal "-pxx*0.101325"
variable p3 equal "-pyy*0.101325"
variable p4 equal "-pzz*0.101325"

thermo     100

thermo_style custom step vol v_strain temp v_p2 v_p3 v_p4 ke pe etotal press density ebond eangle edihed evdwl

#dump       2 all custom 1000 rev_final.* id x y z vx vy vz fx fy fz

#restart 10000 deformation.restart

run  700000

write_data       system_after_deformation			
			

print "All done"		




